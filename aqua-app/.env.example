# AquaAI Environment Configuration

# Optional: Google Gemini API Key for dynamic AI agronomic explanations
# If omitted, AquaAI seamlessly utilizes the built-in deterministic agronomist calculation engine
GEMINI_API_KEY=

# Optional: Supabase PostgreSQL & Auth Configuration
# If omitted, AquaAI seamlessly runs in interactive local demo mode with browser persistence
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Solana Devnet RPC endpoint (defaults to official Devnet, isolated demo)
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
